generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  slug              String             @unique
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  businessUnits     BusinessUnit[]
  auditLogs         AuditLog[]
  branches          Branch[]
  tenantDomains     TenantDomain[]
  tenantMemberships TenantMembership[]
  roles             Role[]
  authenticationSessions AuthenticationSession[]
  customers        Customer[]
  services         Service[]
  appointments     Appointment[]
  staff            Staff[]
  attendance       Attendance[]
  packages         Package[]
  memberships      Membership[]
  invoices         Invoice[]
  invoiceLineItems InvoiceLineItem[]
  categories       Category[]
  products         Product[]
  stockItems       StockItem[]
  stockMovements   StockMovement[]

  @@index([isActive])
}

model TenantDomain {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  domain             String   @unique
  isPrimary          Boolean  @default(false)
  verificationStatus String   @default("pending")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, domain])
  @@index([tenantId, isActive])
  @@index([domain, isActive])
  @@index([isActive, verificationStatus])
}

model BusinessUnit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches                    Branch[]
  businessUnitMembershipRoles BusinessUnitMembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  businessUnitId String   @db.Uuid
  name           String
  slug           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  businessUnit          BusinessUnit           @relation(fields: [tenantId, businessUnitId], references: [tenantId, id], onDelete: Restrict)
  auditLogs             AuditLog[]
  branchMembershipRoles BranchMembershipRole[]
  membershipRoles       MembershipRole[]
  staff                 Staff[]
  stockItems            StockItem[]
  stockMovements        StockMovement[]

  @@unique([tenantId, businessUnitId, id])
  @@unique([tenantId, id])
  @@unique([tenantId, businessUnitId, slug])
  @@index([tenantId, businessUnitId, isActive])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  memberships Membership[]
  invoices Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  name             String
  durationMinutes  Int
  priceCents       Int
  description      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  packages Package[]
  invoiceLineItems InvoiceLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Appointment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  customerId   String   @db.Uuid
  serviceId    String   @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  status       String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  service  Service  @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, startsAt])
  @@index([tenantId, status])
}

model Package {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  serviceIds   String[] @db.Uuid
  priceCents   Int?
  durationDays Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]
  services Service[]
  invoiceLineItems InvoiceLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Membership {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  customerId String    @db.Uuid
  packageId  String    @db.Uuid
  startedAt  DateTime
  endsAt     DateTime?
  status     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  package  Package  @relation(fields: [tenantId, packageId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, startedAt])
  @@index([tenantId, status])
}

model Staff {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  branchId     String?  @db.Uuid
  displayName  String
  email        String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  attendance Attendance[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@index([tenantId, branchId])
}

model Attendance {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  staffId     String    @db.Uuid
  checkInAt   DateTime
  checkOutAt  DateTime?
  status      String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff  Staff  @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, checkInAt])
  @@index([tenantId, status])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  categoryId  String   @db.Uuid
  name        String
  sku         String
  unit        String   @default("pcs")
  priceCents  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category     Category     @relation(fields: [categoryId], references: [tenantId, id], onDelete: Restrict)
  stockItems   StockItem[]
  movements    StockMovement[]
  invoiceLineItems InvoiceLineItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
}

model StockItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  productId   String   @db.Uuid
  branchId    String   @db.Uuid
  quantity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  movements  StockMovement[]

  @@unique([tenantId, productId, branchId])
  @@index([tenantId, branchId])
}

model StockMovement {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  productId    String    @db.Uuid
  branchId     String    @db.Uuid
  movementType String
  quantity     Int
  referenceType String?
  referenceId  String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, productId, branchId])
  @@index([tenantId, referenceId])
}

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  customerId     String   @db.Uuid
  issuedAt       DateTime
  subtotalCents  Int
  discountCents  Int      @default(0)
  gstCents       Int      @default(0)
  totalCents     Int
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  lineItems InvoiceLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId, issuedAt])
  @@index([tenantId, customerId])
}

model InvoiceLineItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  invoiceId      String   @db.Uuid
  description    String
  serviceId      String?  @db.Uuid
  packageId      String?  @db.Uuid
  productId      String?  @db.Uuid
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  service Service? @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  package Package? @relation(fields: [tenantId, packageId], references: [tenantId, id], onDelete: Restrict)
  product Product? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, invoiceId])
  @@index([tenantId, serviceId])
  @@index([tenantId, packageId])
  @@index([tenantId, productId])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  businessUnitId String?  @db.Uuid
  branchId       String?  @db.Uuid
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [tenantId, businessUnitId, branchId], references: [tenantId, businessUnitId, id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId, createdAt])
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  externalAuthId String?  @unique
  email          String?  @unique
  displayName    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships         TenantMembership[]
  passwordCredential  PasswordCredential?
  authenticationSessions AuthenticationSession[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordCredential {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  passwordHash     String
  passwordUpdatedAt DateTime @default(now())
  passwordVersion  Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AuthenticationSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tenantId     String?   @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([tenantId, createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  sessionId    String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  session AuthenticationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([sessionId, revokedAt])
}

model PasswordResetToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model TenantMembership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  roles             MembershipRole[]
  businessUnitRoles BusinessUnitMembershipRole[]
  branchRoles       BranchMembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, userId, isActive])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions             RolePermission[]
  memberships             MembershipRole[]
  businessUnitMemberships BusinessUnitMembershipRole[]
  branchMemberships       BranchMembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId, roleId])
}

model MembershipRole {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  membershipId String   @db.Uuid
  roleId       String   @db.Uuid
  createdAt    DateTime @default(now())

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch?          @relation(fields: [branchId], references: [id])
  branchId   String?          @db.Uuid

  @@unique([tenantId, membershipId, roleId])
  @@index([tenantId, membershipId])
}

model BusinessUnitMembershipRole {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  membershipId   String   @db.Uuid
  roleId         String   @db.Uuid
  businessUnitId String   @db.Uuid
  createdAt      DateTime @default(now())

  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role         Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  businessUnit BusinessUnit     @relation(fields: [tenantId, businessUnitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, membershipId, roleId, businessUnitId])
  @@index([tenantId, membershipId])
  @@index([tenantId, businessUnitId])
}

model BranchMembershipRole {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  membershipId   String   @db.Uuid
  roleId         String   @db.Uuid
  businessUnitId String   @db.Uuid
  branchId       String   @db.Uuid
  createdAt      DateTime @default(now())

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch           @relation(fields: [tenantId, businessUnitId, branchId], references: [tenantId, businessUnitId, id], onDelete: Restrict)

  @@unique([tenantId, membershipId, roleId, businessUnitId, branchId])
  @@index([tenantId, membershipId])
  @@index([tenantId, businessUnitId, branchId])
}
