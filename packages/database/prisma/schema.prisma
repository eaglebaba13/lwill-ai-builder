generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  slug              String             @unique
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  businessUnits     BusinessUnit[]
  auditLogs         AuditLog[]
  branches          Branch[]
  territories       Territory[]
  franchisePartners FranchisePartner[]
  franchiseOutletProfiles FranchiseOutletProfile[]
  franchiseAgreements FranchiseAgreement[]
  franchiseAgreementOutlets FranchiseAgreementOutlet[]
  franchiseRevenueDistributions FranchiseRevenueDistribution[]
  tenantDomains     TenantDomain[]
  tenantSettings    TenantSetting[]
  tenantMemberships TenantMembership[]
  roles             Role[]
  authenticationSessions AuthenticationSession[]
  customers        Customer[]
  services         Service[]
  appointments     Appointment[]
  staff            Staff[]
  attendance       Attendance[]
  packages         Package[]
  memberships      Membership[]
  invoices         Invoice[]
  invoiceLineItems InvoiceLineItem[]
  categories       Category[]
  products         Product[]
  stockItems       StockItem[]
  stockMovements   StockMovement[]
  notificationTemplates NotificationTemplate[]
  notificationLogs      NotificationLog[]
  warehouses            Warehouse[]
  suppliers             Supplier[]
  reorderRules          ReorderRule[]
  purchaseReceipts      PurchaseReceipt[]
  stockTransfers        StockTransfer[]
  stockAdjustments      StockAdjustment[]

  @@index([isActive])
}

model TenantDomain {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  domain             String   @unique
  isPrimary          Boolean  @default(false)
  verificationStatus String   @default("pending")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, domain])
  @@index([tenantId, isActive])
  @@index([domain, isActive])
  @@index([isActive, verificationStatus])
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model BusinessUnit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches                    Branch[]
  businessUnitMembershipRoles BusinessUnitMembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  businessUnitId String   @db.Uuid
  name           String
  slug           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  businessUnit          BusinessUnit           @relation(fields: [tenantId, businessUnitId], references: [tenantId, id], onDelete: Restrict)
  territoryId           String?   @db.Uuid
  territory             Territory? @relation(fields: [tenantId, territoryId], references: [tenantId, id], onDelete: Restrict)
  auditLogs             AuditLog[]
  branchMembershipRoles BranchMembershipRole[]
  membershipRoles       MembershipRole[]
  staff                 Staff[]
  stockItems            StockItem[]
  stockMovements        StockMovement[]
  reorderRules          ReorderRule[]
  purchaseReceipts      PurchaseReceipt[]
  outgoingTransfers     StockTransfer[] @relation("FromBranch")
  incomingTransfers     StockTransfer[] @relation("ToBranch")
  stockAdjustments      StockAdjustment[]
  franchiseOutletProfiles   FranchiseOutletProfile[]
  franchiseAgreementOutlets FranchiseAgreementOutlet[]
  invoices Invoice[]
  appointments Appointment[]

  @@unique([tenantId, businessUnitId, id])
  @@unique([tenantId, id])
  @@unique([tenantId, businessUnitId, slug])
  @@index([tenantId, businessUnitId, isActive])
  @@index([tenantId, territoryId])
}

model Territory {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String
  code           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches       Branch[]
  franchiseOutletProfiles FranchiseOutletProfile[]
  agreements     FranchiseAgreement[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model FranchisePartner {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  userId         String?  @unique @db.Uuid
  name           String
  email          String?
  phone          String?
  panNumber      String?
  gstin          String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User?                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  outletProfiles FranchiseOutletProfile[]
  agreements    FranchiseAgreement[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, isActive])
}

model FranchiseOutletProfile {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  partnerId      String   @db.Uuid
  branchId       String   @db.Uuid
  territoryId    String?  @db.Uuid
  outletType     String?  @default("STANDALONE")
  investmentCents Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partner       FranchisePartner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  branch        Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  territory     Territory?           @relation(fields: [tenantId, territoryId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, branchId])
  @@unique([tenantId, partnerId, branchId])
  @@index([tenantId, partnerId])
  @@index([tenantId, territoryId])
}

model FranchiseAgreement {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @db.Uuid
  partnerId               String    @db.Uuid
  territoryId             String    @db.Uuid
  startDate               DateTime
  endDate                 DateTime?
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  minimumGuaranteeCents   Int?
  mgFormulaRateBp         Int?
  mgFormulaBase           String?
  variableReturnRateBp    Int?
  variableReturnBasis     String?
  payoutRule              String?
  termsSnapshot           Json?
  effectiveFrom           DateTime?
  effectiveTo             DateTime?

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partner    FranchisePartner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  territory  Territory            @relation(fields: [tenantId, territoryId], references: [tenantId, id], onDelete: Restrict)
  outlets    FranchiseAgreementOutlet[]

  @@unique([tenantId, id])
  @@index([tenantId, partnerId])
  @@index([tenantId, territoryId])
  @@index([tenantId, isActive])
}

model FranchiseAgreementOutlet {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  agreementId    String   @db.Uuid
  branchId       String   @db.Uuid
  createdAt      DateTime @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agreement    FranchiseAgreement   @relation(fields: [tenantId, agreementId], references: [tenantId, id], onDelete: Cascade)
  branch       Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  distributions FranchiseRevenueDistribution[]

  @@unique([tenantId, id])
  @@unique([tenantId, agreementId, branchId])
  @@index([tenantId, agreementId])
  @@index([tenantId, branchId])
}

model FranchiseRevenueDistribution {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  agreementOutletId String   @db.Uuid
  beneficiary     String
  percentage      Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agreementOutlet  FranchiseAgreementOutlet @relation(fields: [tenantId, agreementOutletId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, agreementOutletId, beneficiary])
  @@index([tenantId, agreementOutletId])
  @@index([tenantId, beneficiary])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  memberships Membership[]
  invoices Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  name             String
  durationMinutes  Int
  priceCents       Int
  description      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  packages Package[]
  invoiceLineItems InvoiceLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Appointment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  customerId   String   @db.Uuid
  serviceId    String   @db.Uuid
  branchId     String?  @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  status       String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  service  Service  @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  branch   Branch?  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
}

model Package {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  serviceIds   String[] @db.Uuid
  priceCents   Int?
  durationDays Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]
  services Service[]
  invoiceLineItems InvoiceLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Membership {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  customerId String    @db.Uuid
  packageId  String    @db.Uuid
  startedAt  DateTime
  endsAt     DateTime?
  status     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  package  Package  @relation(fields: [tenantId, packageId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, startedAt])
  @@index([tenantId, status])
}

model Staff {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  branchId     String?  @db.Uuid
  displayName  String
  email        String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  attendance Attendance[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@index([tenantId, branchId])
}

model Attendance {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  staffId     String    @db.Uuid
  checkInAt   DateTime
  checkOutAt  DateTime?
  status      String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff  Staff  @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, checkInAt])
  @@index([tenantId, status])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  categoryId  String   @db.Uuid
  name        String
  sku         String
  unit        String   @default("pcs")
  priceCents  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category     Category     @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  stockItems   StockItem[]
  movements    StockMovement[]
  invoiceLineItems InvoiceLineItem[]
  reorderRules ReorderRule[]
  purchaseReceiptLineItems PurchaseReceiptLineItem[]
  stockTransferLineItems StockTransferLineItem[]
  stockAdjustmentLineItems StockAdjustmentLineItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
}

model StockItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  productId   String   @db.Uuid
  branchId    String   @db.Uuid
  quantity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  movements  StockMovement[] @relation("StockItemMovements")

  @@unique([tenantId, productId, branchId])
  @@index([tenantId, branchId])
}

model StockMovement {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  productId    String    @db.Uuid
  branchId     String    @db.Uuid
  movementType String
  quantity     Int
  referenceType String?
  referenceId  String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  stockItem  StockItem @relation("StockItemMovements", fields: [tenantId, productId, branchId], references: [tenantId, productId, branchId])

  @@index([tenantId, productId, branchId])
  @@index([tenantId, referenceId])
}

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  customerId     String   @db.Uuid
  branchId       String?  @db.Uuid
  issuedAt       DateTime
  subtotalCents  Int
  discountCents  Int      @default(0)
  gstCents       Int      @default(0)
  totalCents     Int
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  branch Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  lineItems InvoiceLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId, issuedAt])
  @@index([tenantId, customerId])
  @@index([tenantId, branchId])
}

model InvoiceLineItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  invoiceId      String   @db.Uuid
  description    String
  serviceId      String?  @db.Uuid
  packageId      String?  @db.Uuid
  productId      String?  @db.Uuid
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  service Service? @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  package Package? @relation(fields: [tenantId, packageId], references: [tenantId, id], onDelete: Restrict)
  product Product? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, invoiceId])
  @@index([tenantId, serviceId])
  @@index([tenantId, packageId])
  @@index([tenantId, productId])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  businessUnitId String?  @db.Uuid
  branchId       String?  @db.Uuid
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [tenantId, businessUnitId, branchId], references: [tenantId, businessUnitId, id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId, createdAt])
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  externalAuthId String?  @unique
  email          String?  @unique
  displayName    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships         TenantMembership[]
  passwordCredential  PasswordCredential?
  authenticationSessions AuthenticationSession[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
    franchisePartner   FranchisePartner?
    platformUserRoles  PlatformUserRole[]
}

model PasswordCredential {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  passwordHash     String
  passwordUpdatedAt DateTime @default(now())
  passwordVersion  Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AuthenticationSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tenantId     String?   @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([tenantId, createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  sessionId    String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  session AuthenticationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([sessionId, revokedAt])
}

model PasswordResetToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model TenantMembership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  roles             MembershipRole[]
  businessUnitRoles BusinessUnitMembershipRole[]
  branchRoles       BranchMembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, userId, isActive])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions             RolePermission[]
  memberships             MembershipRole[]
  businessUnitMemberships BusinessUnitMembershipRole[]
  branchMemberships       BranchMembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

    roles RolePermission[]
    platformRolePermissions PlatformRolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId, roleId])
}

model MembershipRole {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  membershipId String   @db.Uuid
  roleId       String   @db.Uuid
  createdAt    DateTime @default(now())

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch?          @relation(fields: [branchId], references: [id])
  branchId   String?          @db.Uuid

  @@unique([tenantId, membershipId, roleId])
  @@index([tenantId, membershipId])
}

model BusinessUnitMembershipRole {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  membershipId   String   @db.Uuid
  roleId         String   @db.Uuid
  businessUnitId String   @db.Uuid
  createdAt      DateTime @default(now())

  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role         Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  businessUnit BusinessUnit     @relation(fields: [tenantId, businessUnitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, membershipId, roleId, businessUnitId])
  @@index([tenantId, membershipId])
  @@index([tenantId, businessUnitId])
}

model BranchMembershipRole {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  membershipId   String   @db.Uuid
  roleId         String   @db.Uuid
  businessUnitId String   @db.Uuid
  branchId       String   @db.Uuid
  createdAt      DateTime @default(now())

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch           @relation(fields: [tenantId, businessUnitId, branchId], references: [tenantId, businessUnitId, id], onDelete: Restrict)

  @@unique([tenantId, membershipId, roleId, businessUnitId, branchId])
  @@index([tenantId, membershipId])
  @@index([tenantId, businessUnitId, branchId])
}

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  channel   String
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, channel])
  @@index([tenantId, isActive])
}

model NotificationLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  recipientId  String?
  channel      String
  subject      String?
  body         String
  status       String
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, channel])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Warehouse {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reorderRules ReorderRule[]
  purchaseReceipts      PurchaseReceipt[]
  outgoingTransfers     StockTransfer[] @relation("FromWarehouse")
  incomingTransfers     StockTransfer[] @relation("ToWarehouse")

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  purchaseReceipts PurchaseReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model ReorderRule {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  productId      String   @db.Uuid
  branchId       String   @db.Uuid
  warehouseId    String   @db.Uuid
  minQuantity    Int
  reorderQuantity Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, branchId, warehouseId])
  @@index([tenantId, isActive])
}

model PurchaseReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  supplierId  String?  @db.Uuid
  warehouseId String   @db.Uuid
  branchId    String   @db.Uuid
  receivedBy  String?
  receivedAt  DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  lineItems  PurchaseReceiptLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId, receivedAt])
}

model PurchaseReceiptLineItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  purchaseReceiptId String   @db.Uuid
  productId        String   @db.Uuid
  quantity         Int

  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, purchaseReceiptId])
}

model StockTransfer {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  fromWarehouseId String @db.Uuid
  toWarehouseId   String @db.Uuid
  fromBranchId    String @db.Uuid
  toBranchId      String @db.Uuid
  status      String   @default("PENDING")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse      @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  fromBranch    Branch         @relation("FromBranch", fields: [tenantId, fromBranchId], references: [tenantId, id], onDelete: Restrict)
  toBranch      Branch         @relation("ToBranch", fields: [tenantId, toBranchId], references: [tenantId, id], onDelete: Restrict)
  lineItems     StockTransferLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model StockTransferLineItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  stockTransferId  String   @db.Uuid
  productId        String   @db.Uuid
  quantity         Int

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, stockTransferId])
}

model StockAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  branchId    String   @db.Uuid
  direction   String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  lineItems  StockAdjustmentLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId, direction])
}

model StockAdjustmentLineItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  stockAdjustmentId String   @db.Uuid
  productId        String   @db.Uuid
  quantity         Int

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, stockAdjustmentId])
}

model PlatformRole {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PlatformRolePermission[]
  userRoles   PlatformUserRole[]

  @@index([isActive])
}

model PlatformRolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       PlatformRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model PlatformUserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role PlatformRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}
