generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  businessUnits BusinessUnit[]
  auditLogs     AuditLog[]
  branches      Branch[]

  @@index([isActive])
}

model BusinessUnit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches Branch[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  businessUnitId String   @db.Uuid
  name           String
  slug           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit @relation(fields: [tenantId, businessUnitId], references: [tenantId, id], onDelete: Restrict)
  auditLogs    AuditLog[]

  @@unique([tenantId, businessUnitId, id])
  @@unique([tenantId, businessUnitId, slug])
  @@index([tenantId, businessUnitId, isActive])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  businessUnitId String?  @db.Uuid
  branchId       String?  @db.Uuid
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [tenantId, businessUnitId, branchId], references: [tenantId, businessUnitId, id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId, createdAt])
}
